# =============================================================================
# AI Crypto Trading Bot - Caddyfile
#
# Caddy v2 reverse proxy configuration.
#
# TLS strategy: built-in automatic Tailscale certificate handling
#   Standard caddy:2-alpine (v2.5+) automatically fetches Let's Encrypt
#   certificates for *.ts.net domains from the locally-running tailscaled
#   daemon at handshake time. No explicit get_certificate directive needed.
#   (get_certificate tailscale is a non-standard xcaddy module not in caddy:2-alpine.)
#
# PREREQUISITES (see CADDY-RUNBOOK.md STEP 0 + STEP 1):
#   1. Hetzner firewall MUST restrict ports 443 and 3001 to 100.64.0.0/10 (Tailscale)
#      BEFORE this stack is deployed.
#   2. Tailscale HTTPS must be enabled in tailnet admin console (one-time toggle).
#   3. TS_PERMIT_CERT_UID must be set in /etc/default/tailscaled on host (see STEP 1c).
#   4. tailscaled.sock must be mounted into this container (see docker-compose.yml).
#   5. Run caddy-config.sh to substitute {{TAILSCALE_FQDN}} before deploying.
# =============================================================================

{
    # Global options
    admin localhost:2019      # Admin API: container-internal only, never 0.0.0.0
    skip_install_trust        # CR-002: suppress Alpine certutil warning (no system store)
    # NOTE: do NOT set `auto_https off` here. That would suppress Caddy's built-in
    # *.ts.net certificate path. ACME is not attempted for .ts.net domains by design,
    # so `auto_https off` provides no benefit and breaks the Tailscale cert flow.
}

# ---------------------------------------------------------------------------
# Primary site - UI + API proxy
#
# Replace {{TAILSCALE_FQDN}} before deploying via: bash infra/caddy-config.sh
# ---------------------------------------------------------------------------
{{TAILSCALE_FQDN}} {
    # NextAuth OAuth callbacks MUST reach the UI container, not the FastAPI backend.
    # This more-specific handle block MUST appear BEFORE handle /api/* because
    # Caddy v2 evaluates handle blocks in source order and stops at the first match.
    handle /api/auth/* {
        reverse_proxy ui:3000
    }

    # WP1.7b (C21, WP17-D-01): admin-gated actions (kill-switch, kill-switch
    # clear, run resume, entries-latch clear) are Next.js server routes under
    # apps/ui/src/app/api/admin/*. Those routes run getServerSession() +
    # isAdmin() first, and only then read INTERNAL_ADMIN_API_KEY server-side
    # and forward it as X-Admin-Key to the FastAPI backend. The browser never
    # holds the admin key.
    #
    # This block MUST appear BEFORE the generic handle /api/* below (same
    # first-match-wins rule as /api/auth/* above) so a request to
    # /api/admin/... reaches ui:3000 (session/role gated) rather than being
    # proxied straight to api:8000.
    #
    # NOTE (WP17-D-01 design decision, see reports/vp2-wp1.7/devops-design.md):
    # FastAPI's own admin endpoints (e.g. /api/v1/emergency/kill-switch,
    # /api/v1/runs/{id}/resume) are intentionally left reachable through the
    # handle /api/* -> api:8000 block below. require_admin() on those routes
    # does a constant-time compare of the caller's X-Admin-Key against the
    # server-side ADMIN_API_KEY secret (apps/api/deps.py); a caller without
    # that secret cannot authenticate no matter which path they use, so the
    # direct api:8000 path is not a bypass of the UI's session/role check --
    # it is a second, equally-authenticated path (kept deliberately, as an
    # operator curl fallback if the ui container is down). Do not add
    # path-based header stripping/blocking for X-Admin-Key here: it would
    # duplicate app-layer auth for no real security gain and add fragility.
    handle /api/admin/* {
        reverse_proxy ui:3000
    }

    # All other /api/* routes go to the FastAPI backend.
    # handle /api/* preserves the full /api/v1/... prefix (NOT handle_path).
    handle /api/* {
        reverse_proxy api:8000
    }

    # Catch-all: everything else goes to the Next.js frontend.
    handle {
        reverse_proxy ui:3000
    }
}

# ---------------------------------------------------------------------------
# Grafana - metrics dashboard on port 3001
# (same FQDN, different port; Tailscale cert is hostname-scoped, port-agnostic)
# ---------------------------------------------------------------------------
{{TAILSCALE_FQDN}}:3001 {
    reverse_proxy grafana:3000
}
